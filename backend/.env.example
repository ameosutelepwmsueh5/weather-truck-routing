# Production settings: set these in your host's dashboard (or copy to backend/.env).
# Local development needs NONE of this - without DJANGO_SECRET_KEY the app runs in DEBUG.
# Once DJANGO_SECRET_KEY is set, DEBUG defaults to false.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-api.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Countries (ISO codes) that place search / geocoding may return. Empty = worldwide.
GEOCODE_COUNTRIES=us,ca,mx
# Optional: truck-aware routing via OpenRouteService's HGV profile (free key at
# https://openrouteservice.org). Without it, routes use OSRM's car profile.
ORS_API_KEY=
# Empty tractor-trailer weight added to the cargo load for the router's weight limits (lb).
TRUCK_EMPTY_WEIGHT_LB=35000
# Optional: Open-Meteo commercial API key. Leave empty to use the free tier
# (600 locations/min, 5,000/hour, 10,000/day, shared by everything on this server's IP).
OPEN_METEO_API_KEY=
# Per-IP request limits (DRF rate syntax)
ANALYZE_RATE_LIMIT=15/min
PLACES_RATE_LIMIT=60/min
# Average truck speed cap used for ETAs (mph)
TRUCK_AVG_SPEED_MPH=55
